# src/ (including the per-provider READMEs under src/Providers/), composer.json,
# README.md, CHANGELOG.md and LICENSE. Everything below is for people working in
# the repo.

/.ai                    export-ignore
/.github                export-ignore
/.junie                 export-ignore
/docs                   export-ignore
/scripts                export-ignore
/tests                  export-ignore

/.cursorrules           export-ignore
